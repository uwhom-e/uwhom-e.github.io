---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { getSortedReferences } from '../lib/references';

const sorted = await getSortedReferences();
const numbers = new Map(sorted.map((entry, i) => [entry.id, i + 1]));

const entriesWithContent = await Promise.all(
  sorted.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base
  title="References | Design Log"
  description="Citations, credits, and inspiration for this project — papers, videos, and open source projects referenced along the way."
>
  <h1 class="y2k-heading text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">References</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
    Papers, videos, open source work, etc. that informed or
    inspired HOM-E.
  </p>

  {sorted.length === 0 && (
    <p class="mt-8 text-slate-500 dark:text-slate-400">No references added yet.</p>
  )}

  <ul class="mt-10 space-y-6">
            {entriesWithContent.map(({ entry, Content }) => {
              const { title, url, author, date } = entry.data;
              return (
                <li id={entry.id} class="y2k-card scroll-mt-6 overflow-hidden rounded-xl target:ring-2 target:ring-teal-500 border border-slate-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
                  <div class="y2k-window-titlebar">
                    <span class="y2k-window-dot"></span>
                    <span class="y2k-window-dot"></span>
                    <span class="y2k-window-dot"></span>
                    <span class="y2k-window-label">{entry.id}</span>
                  </div>
                  <div class="p-5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    {url ? (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-lg font-semibold text-slate-900 hover:text-teal-600 dark:text-white dark:hover:text-teal-400"
                      >
                        <span class="mr-1 font-mono text-sm text-slate-500 dark:text-slate-400">[{numbers.get(entry.id)}]</span>{title}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-1 inline h-4 w-4 -translate-y-0.5">
                          <path d="M7 17 17 7M7 7h10v10"></path>
                        </svg>
                      </a>
                    ) : (
                      <span class="text-lg font-semibold text-slate-900 dark:text-white"><span class="mr-1 font-mono text-sm text-slate-500 dark:text-slate-400">[{numbers.get(entry.id)}]</span>{title}</span>
                    )}
                    {(author || date) && (
                      <span class="text-sm text-slate-500 dark:text-slate-400">
                        {author}
                        {author && date && ' · '}
                        {date && date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
                      </span>
                    )}
                  </div>
                  <div class="prose-log prose-log-compact mt-2">
                    <Content />
                  </div>
                  </div>
                </li>
              );
            })}
  </ul>
</Base>
