---
import Base from '../layouts/Base.astro';
import LogCard from '../components/LogCard.astro';
import Cite from '../components/Cite.astro';
import { getCollection } from 'astro:content';
import { team } from '../data/team';

const allLogs = await getCollection('logs', ({ data }) => !data.draft);
const recentLogs = allLogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<Base title="HOM-E | Capstone Project">
  <section class="py-8 sm:py-12">
    <h1 id="hero-title" class="y2k-heading text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">
      HOM-E
    </h1>
    <h2 class="mt-2 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-teal-600 sm:text-base dark:text-teal-400">
      Bimanual Manipulation on Independent Mobile Bases
    </h2>
    <p class="mt-4 max-w-2xl text-base text-slate-600 sm:text-lg dark:text-slate-400">
      A running record of decisions, iterations, and lessons learned while
      building this project.
    </p>
  </section>

  <div class="y2k-divider" aria-hidden="true">
    <span class="y2k-divider-diamond"></span>
  </div>

  <section class="y2k-window bg-slate-50 dark:bg-neutral-900">
    <div class="y2k-window-titlebar">
      <span class="y2k-window-dot"></span>
      <span class="y2k-window-dot"></span>
      <span class="y2k-window-dot"></span>
      <span class="y2k-window-label">project_proposal</span>
    </div>
    <div class="y2k-window-body">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Project Proposal</h2>
      <div class="prose-log mt-3">
        <p>
          Today's two-handed robots mount both arms on one torso <Cite id="mobile-aloha" />, which fixes
          the distance between them. They cannot handle objects much longer than their arm span, be on
          both sides of a door or table at once, or split up to do two small jobs in parallel.
        </p>
        <p>
          Putting each arm on its own mobile base removes those limits, but the arms no longer know
          exactly where each other are. The robots must work that out with their own sensors and
          coordinate without a rigid link <Cite id="khatib-1996" /><Cite id="body-extension" /><Cite id="chorus" />.
        </p>
        <p>
          This project explores a pair of <strong>identical single-arm mobile robots</strong> that work
          alone on simple tasks and team up when a task needs both. We will build the robots on a
          budget, coordinate them using only onboard sensing, and measure what free bases gain over a
          fixed-spacing arrangement of the same arms.
        </p>
      </div>
    </div>
  </section>

  <div class="y2k-divider" aria-hidden="true">
    <span class="y2k-divider-diamond"></span>
  </div>

  <section>
    <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold text-slate-900 dark:text-white">
      <span class="inline-block h-4 w-1.5 rounded-full" style="background-image: linear-gradient(180deg, #f8fafc, #94a3b8, #475569, #cbd5e1);"></span>
      Team overview
    </h2>
    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
      {team.map((member) => (
        <a
          href={member.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="y2k-card group flex flex-col items-center rounded-xl border border-slate-200 bg-white p-4 text-center transition hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
        >
          <img
            src={`${base}${member.photo.replace(/^\//, '')}`}
            alt={member.name}
            class="h-20 w-20 rounded-full object-cover ring-2 ring-slate-200 transition group-hover:ring-teal-500 dark:ring-neutral-700"
          />
          <p class="mt-3 text-sm font-semibold text-slate-900 group-hover:text-teal-600 dark:text-white dark:group-hover:text-teal-400">
            {member.name}
          </p>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{member.subsystem}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="y2k-divider" aria-hidden="true">
    <span class="y2k-divider-diamond"></span>
  </div>

  <section>
    <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold text-slate-900 dark:text-white">
      <span class="inline-block h-4 w-1.5 rounded-full" style="background-image: linear-gradient(180deg, #f8fafc, #94a3b8, #475569, #cbd5e1);"></span>
      Recent entries
    </h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {recentLogs.map((entry) => <LogCard entry={entry} />)}
    </div>
  </section>
</Base>
